    "LAWS.md",
    "PRINCIPLES.md",
    "SCRIPTURES.md",
    "MYTHOLOGY.md",
    "ECONOMY.md",
    "SECURITY-PRINCIPLES.md",
    "hooks/",
    "tools/"
